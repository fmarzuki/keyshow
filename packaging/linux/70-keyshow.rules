# Keyshow: give the user logged in at the local seat read access to keyboards,
# mice and touchpads (systemd-logind applies "uaccess" as a per-user ACL).
# Must sort before 73-seat-late.rules, which applies the uaccess tag.
SUBSYSTEM=="input", KERNEL=="event*", ENV{ID_INPUT_KEYBOARD}=="1", TAG+="uaccess"
SUBSYSTEM=="input", KERNEL=="event*", ENV{ID_INPUT_MOUSE}=="1", TAG+="uaccess"
SUBSYSTEM=="input", KERNEL=="event*", ENV{ID_INPUT_TOUCHPAD}=="1", TAG+="uaccess"
